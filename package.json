{
  "name": "cv",
  "type": "module",
  "version": "3.1.2",
  "private": true,
  "description": "Personal CV generator: Astro website exported to PDF via Playwright (Chromium)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sanitize-images": "node scripts/sanitize-public-images.mjs",
    "optimize-images": "node scripts/optimize-public-images.mjs",
    "dev": "npm run sanitize-images && astro dev",
    "build": "npm run sanitize-images && npm run optimize-images && astro build",
    "preview": "astro preview",
    "pdf": "node scripts/export-pdf.mjs",
    "build:pdf": "npm run build && npm run pdf"
  },
  "dependencies": {
    "astro": "^7.0.6",
    "js-yaml": "^5.2.2",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "sharp": "^0.35.3"
  }
}
